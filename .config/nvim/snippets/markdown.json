{
  "Zola post frontmatter": {
    "prefix": "post",
    "body": [
      "+++",
      "title = \"${1:Title}\"",
      "date = ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      "updated = ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      "",
      "[taxonomies]",
      "categories = [\"${2:Software}\"]",
      "tags = [\"${3:tag1}\", \"${4:tag2}\"]",
      "",
      "[extra]",
      "authors = [\"AB\"]",
      "math = ${5|true,false|}",
      "toc = \"button\"",
      "+++",
      "",
      "$0"
    ]
  },
  "Journal entry frontmatter": {
    "prefix": "journal",
    "body": [
      "+++",
      "title = \"${1:Title}\"",
      "date = ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      "description = \"${2:One-line summary}\"",
      "+++",
      "",
      "## Shape of the Day",
      "",
      "${3}",
      "",
      "## Notes",
      "",
      "$0"
    ],
    "description": "Zola journal entry frontmatter"
  },
  "Time block": {
    "prefix": "tb",
    "body": [
      "{% time_block(start=\"${1:HH:MM}\", end=\"${2:HH:MM}\", project=\"${3:Area: Project}\", title=\"${4:Title}\") %}",
      "${5}",
      "{% end %}",
      "",
      "$0"
    ],
    "description": "Zola time_block shortcode"
  },
  "Training time block": {
    "prefix": "train",
    "body": [
      "{% time_block(start=\"${1:HH:MM}\", end=\"${2:HH:MM}\", project=\"Training:\", title=\"${3:Run}\") %}",
      "${4}",
      "{% end %}",
      "",
      "$0"
    ],
    "description": "Training area time_block"
  },
  "Sleep time block": {
    "prefix": "sleep",
    "body": [
      "{% time_block(start=\"${1:HH:MM}\", end=\"${2:HH:MM}\", project=\"Sleep:\", title=\"${3:Zzzz}\") %}",
      "${4}",
      "{% end %}",
      "",
      "$0"
    ],
    "description": "Sleep area time_block"
  },
  "Recreation time block": {
    "prefix": "rec",
    "body": [
      "{% time_block(start=\"${1:HH:MM}\", end=\"${2:HH:MM}\", project=\"Recreation:\", title=\"${3:Freddie}\") %}",
      "${4}",
      "{% end %}",
      "",
      "$0"
    ],
    "description": "Recreation area time_block"
  },
  "Meeting notes": {
    "prefix": "meeting",
    "body": [
      "---",
      "title: \"${1:Meeting Title}\"",
      "date: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      "attendees: [${2}]",
      "tags: [meeting]",
      "---",
      "",
      "## Agenda",
      "",
      "${3}",
      "",
      "## Notes",
      "",
      "${4}",
      "",
      "## Action Items",
      "",
      "$0"
    ],
    "description": "Meeting notes template"
  },
  "Theorem box": {
    "prefix": "box",
    "body": ["{% theorem(type=\"box\") %}", "${1}", "{% end %}", "$0"],
    "description": "Zola boxed remark shortcode"
  },
  "Definition": {
    "prefix": "def",
    "body": ["{% theorem(type=\"definition\") %}", "${1}", "{% end %}", "$0"],
    "description": "Zola definition shortcode"
  },
  "Theorem": {
    "prefix": "thm",
    "body": ["{% theorem(type=\"theorem\") %}", "${1}", "{% end %}", "$0"],
    "description": "Zola theorem shortcode"
  },
  "Lemma": {
    "prefix": "lemma",
    "body": ["{% theorem(type=\"lemma\") %}", "${1}", "{% end %}", "$0"],
    "description": "Zola lemma shortcode"
  },
  "Remark": {
    "prefix": "remark",
    "body": ["{% theorem(type=\"remark\") %}", "${1}", "{% end %}", "$0"],
    "description": "Zola remark shortcode"
  },
  "Corollary": {
    "prefix": "cor",
    "body": ["{% theorem(type=\"corollary\") %}", "${1}", "{% end %}", "$0"],
    "description": "Zola corollary shortcode"
  }
}
