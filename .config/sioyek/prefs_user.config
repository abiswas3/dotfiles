# ---- Dark mode on by default ----
default_dark_mode 1
dark_mode_background_color 0.11 0.12 0.14
dark_mode_contrast 0.85

# ---- Soft, classic highlighter colours for the most-used types ----
# a = yellow, b = green, c = blue, d = pink, e = orange
highlight_color_a 1.00 0.92 0.45
highlight_color_b 0.60 0.93 0.60
highlight_color_c 0.60 0.84 1.00
highlight_color_d 1.00 0.70 0.82
highlight_color_e 1.00 0.78 0.45
