/* Clean, self-contained window-switcher theme (no pywal, no external imports) */
* {
    font:        "JetBrains Mono 12";
    bg:          #15151deb;
    bg-alt:      #20202c;
    fg:          #e6e6ee;
    fg-dim:      #9a9ab0;
    accent:      #7aa2f7;
    sel-fg:      #14141b;
    transparent: #00000000;
}

window {
    transparency:     "real";
    location:         center;
    width:            620px;
    border-radius:    18px;
    background-color: @bg;
    border:           1px;
    border-color:     #ffffff1f;
    padding:          14px;
}

mainbox {
    background-color: @transparent;
    spacing:          10px;
    children:         [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius:    12px;
    padding:          10px 14px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: @transparent;
    text-color:       @accent;
}

entry {
    background-color:  @transparent;
    text-color:        @fg;
    placeholder:       "Search windows";
    placeholder-color: @fg-dim;
    cursor:            text;
}

listview {
    background-color: @transparent;
    lines:            8;
    scrollbar:        false;
    spacing:          4px;
    dynamic:          true;
}

element {
    background-color: @transparent;
    text-color:       @fg;
    padding:          9px 12px;
    border-radius:    10px;
}

element selected {
    background-color: @accent;
    text-color:       @sel-fg;
}

element-text {
    background-color: @transparent;
    text-color:       inherit;
}
